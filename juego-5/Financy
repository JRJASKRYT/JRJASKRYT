<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>El Mes del Dinero</title>
<style>
  :root{
    --bg-dark:#0e0f13;
    --panel:#1a1c23;
    --panel-2:#22252e;
    --accent:#4fd1c5;
    --danger:#ff5b6e;
    --warn:#ffb648;
    --text:#eef1f5;
    --muted:#8a90a2;
  }
  *{box-sizing:border-box; margin:0; padding:0;}
  html,body{
    height:100%;
    background:radial-gradient(circle at 50% 0%, #1e2130 0%, #0a0b0f 70%);
    font-family:'Segoe UI', Roboto, Arial, sans-serif;
    color:var(--text);
    display:flex;
    align-items:center;
    justify-content:center;
    overflow:hidden;
  }
  #phone{
    width:390px;
    max-width:100vw;
    height:100vh;
    max-height:844px;
    background:var(--bg-dark);
    border-radius:34px;
    border:8px solid #05060a;
    box-shadow:0 0 0 2px #2a2d3a, 0 20px 60px rgba(0,0,0,.6);
    display:flex;
    flex-direction:column;
    position:relative;
    overflow:hidden;
  }
  #notch{
    width:140px; height:22px;
    background:#05060a;
    border-radius:0 0 16px 16px;
    position:absolute;
    top:0; left:50%;
    transform:translateX(-50%);
    z-index:40;
  }

  /* START SCREEN */
  #start-screen{
    position:absolute;
    inset:0;
    z-index:50;
    background:linear-gradient(180deg,#161a24 0%, #0a0b0f 75%);
    display:flex;
    flex-direction:column;
    align-items:center;
    justify-content:center;
    text-align:center;
    padding:44px 28px;
  }
  #start-icon{font-size:52px; margin-bottom:14px;}
  #start-title{font-size:23px; font-weight:800; margin-bottom:10px; color:var(--accent);}
  #start-sub{font-size:13.5px; color:var(--muted); margin-bottom:22px; line-height:1.5;}
  #start-money{
    background:var(--panel);
    border:1px solid #33384a;
    border-radius:16px;
    padding:14px 22px;
    margin-bottom:22px;
  }
  #start-money .amount{font-size:26px; font-weight:800; color:#3ddc97;}
  #start-money .label{font-size:11.5px; color:var(--muted); letter-spacing:.4px; text-transform:uppercase;}
  #start-rules{
    text-align:left;
    font-size:12.5px;
    color:var(--text);
    line-height:1.7;
    margin-bottom:26px;
    max-width:280px;
  }
  #start-rules b{color:var(--accent);}
  #start-btn{
    background:var(--accent);
    color:#0a0b0f;
    border:none;
    padding:14px 30px;
    border-radius:30px;
    font-size:14.5px;
    font-weight:800;
    cursor:pointer;
  }
  #start-btn:hover{filter:brightness(1.08);}

  /* STATS HEADER */
  #stats{
    padding:34px 16px 10px 16px;
    display:grid;
    grid-template-columns:1fr 1fr;
    gap:10px 14px;
  }
  .stat{
    background:var(--panel);
    border-radius:12px;
    padding:8px 10px;
    display:flex;
    flex-direction:column;
    gap:5px;
  }
  .stat-top{
    display:flex;
    align-items:center;
    justify-content:space-between;
    font-size:12px;
    color:var(--muted);
  }
  .stat-top .icon{font-size:16px;}
  .stat-top .val{font-weight:600; color:var(--text);}
  .bar-track{
    width:100%;
    height:7px;
    background:#0d0e13;
    border-radius:6px;
    overflow:hidden;
  }
  .bar-fill{
    height:100%;
    border-radius:6px;
    transition:width .35s ease, background-color .35s ease;
  }
  #bar-dinero{background:linear-gradient(90deg,#3ddc97,#4fd1c5);}
  #bar-necesidades{background:linear-gradient(90deg,#ffb648,#ff8f4d);}
  #bar-ocio{background:linear-gradient(90deg,#a78bfa,#f472b6);}
  #bar-salud{background:linear-gradient(90deg,#ff5b6e,#ff8fa3);}
  #bar-dinero.low{background:linear-gradient(90deg,#ff5b6e,#ffb648);}

  /* CARD AREA */
  #card-area{
    flex:1;
    display:flex;
    align-items:center;
    justify-content:center;
    padding:6px 18px;
    position:relative;
  }
  #card{
    width:100%;
    max-width:320px;
    background:var(--panel);
    border-radius:20px;
    padding:20px 18px 16px 18px;
    display:flex;
    flex-direction:column;
    align-items:center;
    text-align:center;
    box-shadow:0 12px 30px rgba(0,0,0,.4);
    transition:transform .25s ease, opacity .25s ease;
  }
  #card.swipe-left{transform:translateX(-140%) rotate(-10deg); opacity:0;}
  #card.swipe-right{transform:translateX(140%) rotate(10deg); opacity:0;}
  #card-tag{
    font-size:10.5px;
    font-weight:700;
    letter-spacing:.6px;
    color:#0a0b0f;
    background:var(--accent);
    padding:4px 10px;
    border-radius:20px;
    margin-bottom:10px;
  }
  #npc-avatar{
    width:70px; height:70px;
    border-radius:50%;
    background:var(--panel-2);
    display:flex;
    align-items:center;
    justify-content:center;
    font-size:34px;
    margin-bottom:10px;
    border:2px solid #33384a;
  }
  #npc-name{
    font-size:13px;
    font-weight:700;
    color:var(--accent);
    letter-spacing:.3px;
    margin-bottom:8px;
    text-transform:uppercase;
  }
  #npc-text{
    font-size:15px;
    line-height:1.45;
    color:var(--text);
    min-height:70px;
  }

  /* CONTROLS */
  #controls{
    display:flex;
    gap:10px;
    padding:14px 18px 4px 18px;
  }
  .choice-btn{
    flex:1;
    position:relative;
    background:var(--panel-2);
    border:1px solid #333747;
    color:var(--text);
    border-radius:14px;
    padding:12px 8px;
    font-size:13.5px;
    cursor:pointer;
    transition:background .2s, transform .15s;
  }
  .choice-btn:hover{background:#2b2f3c; transform:translateY(-2px);}
  .choice-btn:active{transform:translateY(0);}
  .choice-label{display:block; font-weight:600; margin-bottom:2px;}
  .choice-sub{display:block; font-size:12px; color:var(--muted);}
  .tooltip{
    position:absolute;
    bottom:calc(100% + 8px);
    left:50%;
    transform:translateX(-50%) translateY(4px);
    background:#05060a;
    border:1px solid #333747;
    color:var(--text);
    font-size:11.5px;
    white-space:nowrap;
    padding:6px 10px;
    border-radius:8px;
    opacity:0;
    pointer-events:none;
    transition:opacity .15s, transform .15s;
    z-index:10;
  }
  .choice-btn:hover .tooltip{opacity:1; transform:translateX(-50%) translateY(0);}

  /* FOOTER */
  #footer{
    text-align:center;
    padding:6px 0 18px 0;
    font-size:12px;
    color:var(--muted);
    letter-spacing:.3px;
  }
  #footer .step-dots{
    display:inline-flex;
    gap:5px;
    margin-left:8px;
    vertical-align:middle;
  }
  #footer .dot{
    width:6px; height:6px;
    border-radius:50%;
    background:#333747;
    display:inline-block;
  }
  #footer .dot.active{background:var(--accent);}

  /* END SCREEN */
  #end-screen{
    position:absolute;
    inset:0;
    display:none;
    align-items:center;
    justify-content:center;
    flex-direction:column;
    text-align:center;
    padding:40px 30px;
    z-index:30;
  }
  #end-screen.win{background:linear-gradient(180deg,#0e1f18,#0a0b0f 70%);}
  #end-screen.lose{background:linear-gradient(180deg,#2a0f14,#0a0b0f 70%);}
  #end-icon{font-size:56px; margin-bottom:16px;}
  #end-title{font-size:22px; font-weight:700; margin-bottom:12px;}
  #end-title.win-color{color:#3ddc97;}
  #end-title.lose-color{color:var(--danger);}
  #end-text{font-size:14.5px; line-height:1.5; color:var(--text); margin-bottom:12px;}
  #end-stats{font-size:12.5px; color:var(--muted); margin-bottom:26px;}
  #retry-btn{
    background:var(--accent);
    color:#0a0b0f;
    border:none;
    padding:12px 26px;
    border-radius:30px;
    font-size:14px;
    font-weight:700;
    cursor:pointer;
  }
  #retry-btn:hover{filter:brightness(1.08);}

  @media (max-height:700px){
    #npc-text{min-height:55px;}
    #stats{padding-top:26px;}
  }
</style>
</head>
<body>

<div id="phone">
  <div id="notch"></div>

  <div id="start-screen">
    <div id="start-icon">💸</div>
    <div id="start-title">El Mes del Dinero</div>
    <div id="start-sub">Administra tus finanzas durante 30 días y llega a fin de mes sin quebrar ni descuidarte.</div>
    <div id="start-money">
      <div class="amount">Bs 3.000</div>
      <div class="label">Dinero inicial</div>
    </div>
    <div id="start-rules">
      Cada día tomarás <b>3 decisiones</b>:<br>
      🚌 <b>Transporte</b> — cómo te mueves<br>
      🍽️ <b>Comida</b> — qué comes<br>
      🎲 <b>Evento del día</b> — un imprevisto o gasto extra<br><br>
      Si tu dinero llega a <b>Bs 0</b>, o tu salud/bienestar colapsan, pierdes. ¡Sobrevive los 30 días!
    </div>
    <button id="start-btn">▶ Comenzar</button>
  </div>

  <div id="stats">
    <div class="stat">
      <div class="stat-top"><span class="icon">💰</span><span>Dinero</span><span class="val" id="val-dinero">Bs 3000</span></div>
      <div class="bar-track"><div class="bar-fill" id="bar-dinero" style="width:50%"></div></div>
    </div>
    <div class="stat">
      <div class="stat-top"><span class="icon">🏠</span><span>Necesidades</span><span class="val" id="val-necesidades">50%</span></div>
      <div class="bar-track"><div class="bar-fill" id="bar-necesidades" style="width:50%"></div></div>
    </div>
    <div class="stat">
      <div class="stat-top"><span class="icon">🎮</span><span>Gustos</span><span class="val" id="val-ocio">50%</span></div>
      <div class="bar-track"><div class="bar-fill" id="bar-ocio" style="width:50%"></div></div>
    </div>
    <div class="stat">
      <div class="stat-top"><span class="icon">❤️</span><span>Salud</span><span class="val" id="val-salud">50%</span></div>
      <div class="bar-track"><div class="bar-fill" id="bar-salud" style="width:50%"></div></div>
    </div>
  </div>

  <div id="card-area">
    <div id="card">
      <div id="card-tag">...</div>
      <div id="npc-avatar">🙂</div>
      <div id="npc-name">Cargando...</div>
      <div id="npc-text">...</div>
    </div>
  </div>

  <div id="controls">
    <button class="choice-btn" id="btn-left">
      <span class="choice-label">👈 Opción A</span>
      <span class="choice-sub" id="left-label">...</span>
      <span class="tooltip" id="tooltip-left"></span>
    </button>
    <button class="choice-btn" id="btn-right">
      <span class="choice-label">👉 Opción B</span>
      <span class="choice-sub" id="right-label">...</span>
      <span class="tooltip" id="tooltip-right"></span>
    </button>
  </div>

  <div id="footer">
    Día <span id="day-counter">1</span> de 30
    <span class="step-dots" id="step-dots">
      <span class="dot" data-i="0"></span>
      <span class="dot" data-i="1"></span>
      <span class="dot" data-i="2"></span>
    </span>
  </div>

  <div id="end-screen">
    <div id="end-icon">🎉</div>
    <div id="end-title">Título</div>
    <div id="end-text">Texto</div>
    <div id="end-stats"></div>
    <button id="retry-btn">🔄 Reintentar / Volver a jugar</button>
  </div>
</div>

<script>
(function(){
  "use strict";

  const START_MONEY = 3000;
  const MAX_DAY = 30;
  const MONEY_BAR_MAX = 6000; // referencia visual para la barra de dinero
  const DEBT_INTEREST = 25;   // Bs que se pierden cada día si hay deuda activa

  // ---------- ESTADO DEL JUEGO ----------
  const state = {
    bs:START_MONEY,
    necesidades:50,
    ocio:50,
    salud:50,
    day:1,
    phase:0, // 0 transporte, 1 comida, 2 evento
    debtActive:false,
    lastTransport:null,
    lastComida:null,
    lastEvent:null
  };

  // ---------- PLANTILLAS RECURRENTES ----------
  const transporteTemplates = [
    { npc:"Rumbo al día", avatar:"🚌", text:"Es hora de moverte por la ciudad. ¿Cómo llegas hoy a tu destino?",
      left:{ label:"Caminar / micro público", effects:{bs:-3, necesidades:0, ocio:0, salud:2} },
      right:{ label:"Pedir taxi por app", effects:{bs:-18, necesidades:0, ocio:3, salud:-1} }
    },
    { npc:"Hora de salir", avatar:"🚕", text:"Vas con el tiempo justo. ¿Qué transporte eliges?",
      left:{ label:"Trufi / transporte público", effects:{bs:-4, necesidades:0, ocio:0, salud:1} },
      right:{ label:"Radio taxi directo", effects:{bs:-22, necesidades:0, ocio:2, salud:0} }
    }
  ];

  const comidaTemplates = [
    { npc:"Hora de almorzar", avatar:"🍲", text:"Es hora de almuerzo. ¿Qué decides comer hoy?",
      left:{ label:"Cocinar / llevar vianda", effects:{bs:-12, necesidades:0, ocio:0, salud:4} },
      right:{ label:"Comprar comida afuera", effects:{bs:-35, necesidades:0, ocio:4, salud:-2} }
    },
    { npc:"Hora de cenar", avatar:"🍛", text:"Llegó la noche y tienes hambre. ¿Qué cenas?",
      left:{ label:"Preparar algo simple en casa", effects:{bs:-10, necesidades:0, ocio:0, salud:3} },
      right:{ label:"Pedir delivery", effects:{bs:-38, necesidades:0, ocio:5, salud:-2} }
    }
  ];

  // ---------- EVENTOS DEL DÍA ----------
  const events = {
    rent: { npc:"Cobrador de Alquiler", avatar:"🧾",
      text:"Llegó la fecha del pago mensual de tu alquiler. ¿Qué haces?",
      left:{ label:"Pagar a tiempo", effects:{bs:-300, necesidades:15, ocio:0, salud:0} },
      right:{ label:"Aplazar con mora", effects:{bs:-400, necesidades:0, ocio:10, salud:0} }
    },
    concert: { npc:"Tu mejor amigo", avatar:"🎤",
      text:"Un amigo te invita a un concierto exclusivo este fin de semana.",
      left:{ label:"Rechazar e ir a estudiar", effects:{bs:0, necesidades:0, ocio:-10, salud:0} },
      right:{ label:"Comprar entrada VIP", effects:{bs:-250, necesidades:0, ocio:25, salud:0} }
    },
    phone: { npc:"Tu Celular", avatar:"📱",
      text:"¡Imprevisto! Se te cayó el celular y la pantalla se rompió.",
      left:{ label:"Reparar con ahorros", effects:{bs:-350, necesidades:0, ocio:0, salud:10} },
      right:{ label:"Pagar con tarjeta de crédito", effects:{bs:-150, necesidades:5, ocio:0, salud:0}, setsDebt:true }
    },
    utilities: { npc:"Empresa de Servicios", avatar:"💡",
      text:"Llegó la factura de luz y agua del mes.",
      left:{ label:"Pagar completo", effects:{bs:-180, necesidades:15, ocio:0, salud:0} },
      right:{ label:"Pagar el mínimo", effects:{bs:-60, necesidades:0, ocio:0, salud:-20} }
    },
    freelance: { npc:"Cliente Freelance", avatar:"💻",
      text:"Te ofrecen un trabajo freelance para este fin de semana.",
      left:{ label:"Aceptar el trabajo", effects:{bs:400, necesidades:0, ocio:0, salud:-15} },
      right:{ label:"Descansar y salir", effects:{bs:0, necesidades:0, ocio:10, salud:10} }
    },
    streaming: { npc:"Servicios de Streaming", avatar:"📺",
      text:"Revisas tus suscripciones y notas que pagas por varias que casi no usas.",
      left:{ label:"Cancelar las que no usas", effects:{bs:20, necesidades:0, ocio:-5, salud:0} },
      right:{ label:"Mantener todas", effects:{bs:-30, necesidades:0, ocio:10, salud:0} }
    },
    gift: { npc:"Amigo de Cumpleaños", avatar:"🎁",
      text:"Un amigo cercano cumple años y quieres darle un regalo.",
      left:{ label:"Regalo sencillo", effects:{bs:-30, necesidades:0, ocio:5, salud:0} },
      right:{ label:"Regalo caro para lucirte", effects:{bs:-120, necesidades:0, ocio:15, salud:0} }
    },
    clothes: { npc:"Tienda de Ropa", avatar:"👕",
      text:"Ves una oferta de ropa nueva que te gusta mucho.",
      left:{ label:"Resistir la tentación", effects:{bs:0, necesidades:0, ocio:-5, salud:0} },
      right:{ label:"Comprar ropa nueva", effects:{bs:-150, necesidades:0, ocio:10, salud:0} }
    },
    checkup: { npc:"Clínica de Salud", avatar:"🩺",
      text:"Tienes disponible un chequeo médico preventivo.",
      left:{ label:"Ir al chequeo", effects:{bs:-50, necesidades:0, ocio:0, salud:15} },
      right:{ label:"Postergar la cita", effects:{bs:0, necesidades:0, ocio:0, salud:-10} }
    },
    weekend: { npc:"Grupo de Amigos", avatar:"🎊",
      text:"Tus amigos organizan un plan para el fin de semana.",
      left:{ label:"Plan económico en casa", effects:{bs:-20, necesidades:0, ocio:10, salud:0} },
      right:{ label:"Salir a un bar caro", effects:{bs:-200, necesidades:0, ocio:15, salud:0} }
    }
  };

  const fixedEventDays = {1:"rent", 5:"concert", 15:"phone", 20:"utilities", 25:"freelance"};
  const eventPool = ["streaming","gift","clothes","checkup","weekend"];

  function pickFrom(pool, lastKey, keyProp){
    let idx;
    do{
      idx = Math.floor(Math.random()*pool.length);
    } while(pool.length>1 && pool[idx] === lastKey);
    return pool[idx];
  }

  // ---------- UI HELPERS ----------
  const el = id => document.getElementById(id);

  function fmtEffects(effects){
    const parts = [];
    if(effects.bs){
      parts.push(`💰${effects.bs>0?"+":""}${effects.bs}Bs`);
    }
    const icons = {necesidades:"🏠", ocio:"🎮", salud:"❤️"};
    for(const key of ["necesidades","ocio","salud"]){
      const v = effects[key];
      if(v){
        parts.push(`${icons[key]}${v>0?"+":""}${v}%`);
      }
    }
    return parts.length ? parts.join("  ") : "Sin cambios";
  }

  function updateStatsUI(){
    el("val-dinero").textContent = "Bs " + Math.round(state.bs);
    const moneyPct = Math.max(0, Math.min(100, (state.bs/MONEY_BAR_MAX)*100));
    const moneyBar = el("bar-dinero");
    moneyBar.style.width = moneyPct + "%";
    moneyBar.classList.toggle("low", state.bs < 600);

    const map = ["necesidades","ocio","salud"];
    for(const key of map){
      const v = Math.round(state[key]);
      el("val-"+key).textContent = v + "%";
      el("bar-"+key).style.width = v + "%";
    }

    el("day-counter").textContent = state.day;
    document.querySelectorAll("#step-dots .dot").forEach(dot=>{
      dot.classList.toggle("active", Number(dot.dataset.i) === state.phase);
    });
  }

  let currentCard = null;

  function getCurrentCardData(){
    if(state.phase === 0){
      const idx = transporteTemplates.indexOf(state.lastTransport);
      let card;
      do{
        card = transporteTemplates[Math.floor(Math.random()*transporteTemplates.length)];
      } while(transporteTemplates.length>1 && card === state.lastTransport);
      state.lastTransport = card;
      return {tag:"🚌 TRANSPORTE", card};
    }
    if(state.phase === 1){
      let card;
      do{
        card = comidaTemplates[Math.floor(Math.random()*comidaTemplates.length)];
      } while(comidaTemplates.length>1 && card === state.lastComida);
      state.lastComida = card;
      return {tag:"🍽️ COMIDA", card};
    }
    // phase 2: evento
    let key;
    if(fixedEventDays[state.day]){
      key = fixedEventDays[state.day];
    } else {
      key = pickFrom(eventPool, state.lastEvent);
      state.lastEvent = key;
    }
    return {tag:"🎲 EVENTO DEL DÍA", card: events[key]};
  }

  function renderCard(){
    const {tag, card} = getCurrentCardData();
    currentCard = card;
    el("card-tag").textContent = tag;
    el("npc-avatar").textContent = card.avatar;
    el("npc-name").textContent = card.npc;
    el("npc-text").textContent = card.text;
    el("left-label").textContent = card.left.label;
    el("right-label").textContent = card.right.label;
    el("tooltip-left").textContent = fmtEffects(card.left.effects);
    el("tooltip-right").textContent = fmtEffects(card.right.effects);
    updateStatsUI();
  }

  function clampPct(v){ return Math.max(0, Math.min(100, v)); }

  function applyChoice(choice){
    if(choice.setsDebt){
      state.debtActive = true;
    }
    state.bs += choice.effects.bs;
    state.necesidades = clampPct(state.necesidades + choice.effects.necesidades);
    state.ocio = clampPct(state.ocio + choice.effects.ocio);
    state.salud = clampPct(state.salud + choice.effects.salud);
  }

  function checkGameOver(){
    if(state.bs <= 0){
      return {lose:true, reason:"bankruptcy"};
    }
    if(state.salud <= 0 || state.ocio <= 0){
      return {lose:true, reason:"stress"};
    }
    if(state.necesidades <= 0 || state.necesidades >= 100 || state.ocio >= 100 || state.salud >= 100){
      return {lose:true, reason:"extreme"};
    }
    return {lose:false};
  }

  function showEnd(type, reason){
    const screen = el("end-screen");
    const title = el("end-title");
    const icon = el("end-icon");
    const text = el("end-text");
    const stats = el("end-stats");

    screen.style.display = "flex";
    screen.classList.remove("win","lose");
    title.classList.remove("win-color","lose-color");

    if(type === "win"){
      screen.classList.add("win");
      title.classList.add("win-color");
      icon.textContent = "🎉";
      title.textContent = "¡Victoria!";
      text.textContent = "¡Felicidades! Lograste administrar tu dinero con éxito durante un mes. Aprendiste a equilibrar el ahorro sin descuidar tu vida personal.";
    } else {
      screen.classList.add("lose");
      title.classList.add("lose-color");
      icon.textContent = "💥";
      title.textContent = "Fin del juego";
      if(reason === "bankruptcy"){
        text.textContent = "¡Bancarrota! Te quedaste sin dinero antes de fin de mes.";
      } else if(reason === "stress"){
        text.textContent = "¡Colapso por estrés! Ahorrarlo todo te hizo descuidar tu salud y bienestar.";
      } else {
        text.textContent = "Perdiste el control de tus finanzas o tu bienestar. Un extremo en cualquier sentido también te pasa factura.";
      }
    }
    stats.textContent = `Llegaste al día ${state.day} con Bs ${Math.round(state.bs)} en tu bolsillo.`;
  }

  function nextTurn(side){
    const card = el("card");
    card.classList.add(side === "left" ? "swipe-left" : "swipe-right");

    setTimeout(()=>{
      const choice = side === "left" ? currentCard.left : currentCard.right;
      applyChoice(choice);

      const result = checkGameOver();
      if(result.lose){
        updateStatsUI();
        showEnd("lose", result.reason);
        return;
      }

      state.phase++;
      if(state.phase > 2){
        state.phase = 0;
        state.day++;
        if(state.debtActive){
          state.bs -= DEBT_INTEREST;
          const debtResult = checkGameOver();
          if(debtResult.lose){
            updateStatsUI();
            showEnd("lose", debtResult.reason);
            return;
          }
        }
        if(state.day > MAX_DAY){
          updateStatsUI();
          showEnd("win");
          return;
        }
      }

      card.classList.remove("swipe-left","swipe-right");
      renderCard();
    }, 220);
  }

  function resetGame(){
    state.bs = START_MONEY;
    state.necesidades = 50;
    state.ocio = 50;
    state.salud = 50;
    state.day = 1;
    state.phase = 0;
    state.debtActive = false;
    state.lastTransport = null;
    state.lastComida = null;
    state.lastEvent = null;
    el("end-screen").style.display = "none";
    renderCard();
  }

  el("btn-left").addEventListener("click", ()=>nextTurn("left"));
  el("btn-right").addEventListener("click", ()=>nextTurn("right"));
  el("retry-btn").addEventListener("click", resetGame);
  el("start-btn").addEventListener("click", ()=>{
    el("start-screen").style.display = "none";
    resetGame();
  });

  document.addEventListener("keydown", (e)=>{
    if(el("start-screen").style.display !== "none") return;
    if(el("end-screen").style.display === "flex") return;
    if(e.key === "ArrowLeft") nextTurn("left");
    if(e.key === "ArrowRight") nextTurn("right");
  });

  // ---------- ESTADO INICIAL (sin arrancar el juego) ----------
  updateStatsUI();
})();
</script>

</body>
</html>
